# Variáveis de ambiente do portfólio
# Copie para .env.local se quiser testar localmente

# ── Formulário de contato via GitHub (sem serviços externos) ──────────────
# Repositório onde os contatos serão registrados como Issues
VITE_CONTACT_REPO=Savitargood/portfolio-savitargood

# Fine-grained PAT com permissão APENAS "Issues: Read and write" neste repo.
# Crie em: GitHub → Settings → Developer settings → Fine-grained tokens
# ⚠️ Importante: limite o acesso somente a este repositório e à permissão de Issues.
VITE_GITHUB_CONTACT_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx

# ── Opcional (deploy no Vercel, se usar) ──────────────────────────────────
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CONTACT_EMAIL=seu@email.com
