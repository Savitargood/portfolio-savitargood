# Variáveis de ambiente necessárias
# Copie este arquivo para .env.local e preencha os valores

# Chave da API Resend (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# E-mail de destino para as mensagens do formulário de contato
CONTACT_EMAIL=seu@email.com

# Token do Lighthouse CI App (opcional — para comentários automáticos em PRs)
# LHCI_GITHUB_APP_TOKEN=
